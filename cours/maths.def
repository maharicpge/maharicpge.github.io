\def\dt{{\operator@font d}}
\def\d{{\operator@font d}}
\def\dd#1#2{
	\frac{\partial#1}{\partial#2}
  }
\def\ddeux#1#2#3{
	\def\a{#2}\def\b{#3} 
	\ifx\a\b \frac{\partial^{2}#1}{\partial\a^{2}}
	\else \frac{\partial^{2}#1}{\partial\a\partial\b}
	\fi
}




\newcommand{\numer}[2][]{\begingroup%
	\def\@parametre{#1}\def\@valeur{b}%
	\sffamily\bfseries%
	\ifx\@parametre\@valeur\else\color{colstroke}\fi%
	#2%
	\endgroup}
	
